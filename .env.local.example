# ─── Google Calendar (Booking Availability) ───────────────────────────────────
# Step 1: Go to https://console.cloud.google.com
# Step 2: Create a project → Enable "Google Calendar API"
# Step 3: IAM & Admin → Service Accounts → Create → Download JSON key
# Step 4: Open the JSON key file and copy the values below
# Step 5: In Google Calendar → Settings → Share with specific people → add the service account email
#         Grant "See all event details" permission

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your.calendar.id@gmail.com

# ─── Gmail Contact Form ────────────────────────────────────────────────────────
# Step 1: Go to your Google Account → Security → 2-Step Verification (enable it)
# Step 2: Search "App passwords" → Create one for "Mail" → copy the 16-char password
# Step 3: Paste here (no spaces)

GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=abcdabcdabcdabcd
